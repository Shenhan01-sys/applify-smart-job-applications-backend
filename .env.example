# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=4000
# Comma-separated CORS allowlist. Vite falls back to 5174 when 5173 is already taken.
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Security
# Kunci enkripsi sesi platform (cookie LinkedIn dll.). WAJIB, minimal 32 karakter, dan tidak ada kunci bawaan:
# tanpa kunci yang sah (kosong, pendek, atau nilai contoh ini) sesi tidak disimpan atau dibaca (503) dan
# server mencatat galat konfigurasi saat start. Buat dengan: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=your-32-character-encryption-key-here!!

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-...
# Batas permintaan /api/ai/* per pengguna, dihitung dari application_logs (berlaku lintas proses PM2).
# Lewat batas: 429 rate_limited. Nilai tidak valid memakai bawaan.
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_RATE_LIMIT_PER_HOUR=60
# Batas impor profil dari PDF LinkedIn (/api/profile/import/linkedin-pdf) per pengguna; terpisah dari batas di atas.
# PROFILE_IMPORT_RATE_LIMIT_PER_MINUTE=3
# PROFILE_IMPORT_RATE_LIMIT_PER_HOUR=10
# Batas waktu jawaban AI saat membuat permintaan persetujuan (ms). Lewat batas: jawaban dikosongkan dan ditandai.
# APPROVAL_ANSWER_TIMEOUT_MS=25000

# Optional: Redis for BullMQ — DEPRECATED (2026-08-03).
# Queue kini memakai database-as-queue (automation_queue), tidak lagi BullMQ/Redis.
# Isi ini TIDAK diperlukan; backend berjalan tanpa Redis. Dibiarkan utk kompatibilitas.
# REDIS_URL=redis://localhost:6379

# Optional: Langfuse untuk tracing
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agregasi lowongan multi-portal (opsional)
# APPLIFY_JOBS_MCP_PORT=8090          # port Applify Jobs MCP server mode HTTP (npm run mcp:jobs:http)
# JOB_BOARDS_CONFIG=./config/job-boards.json
# GLINTS_BROWSER_FALLBACK=true        # false = jangan pakai Playwright saat API Glints diblok WAF

# --- Deploy (Railway / Docker) ---
# Railway menyuntikkan PORT sendiri. Server mendengarkan 0.0.0.0:$PORT. Jangan diisi manual di Railway.
# NODE_ENV=production                 # sudah diset di Dockerfile. Log menjadi JSON dan peringatan konfigurasi aktif.
# FRONTEND_URL: urutan penting. Origin PERTAMA dipakai sebagai tujuan redirect setelah Gmail OAuth.
#   Contoh produksi: FRONTEND_URL=https://applify-xxx.vercel.app,http://localhost:5173
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium   # sudah diset di Dockerfile; kosongkan di mesin lokal

# Ekstensi browser Applify (rute /api/extension/*)
# EXTENSION_ORIGINS: daftar origin ekstensi yang boleh memanggil API dari browser, dipisah koma, cocok persis.
#   Contoh produksi: EXTENSION_ORIGINS=chrome-extension://<id-ekstensi-applify-32-huruf-a-sampai-p>
#   WAJIB diisi di produksi (NODE_ENV=production). Bila kosong di produksi, tidak ada origin ekstensi yang
#   diizinkan (CORS menolak). Bila kosong di pengembangan/uji, format ID ekstensi Chromium apa pun diterima.
# EXTENSION_TOKEN_SECRET: kunci tanda tangan token ekstensi, minimal 32 karakter. Bila kosong dipakai SESSION_ENCRYPTION_KEY.
# EXTENSION_ORIGINS=
# EXTENSION_TOKEN_SECRET=

# Gmail OAuth (opsional; wajib bila fitur email apply dipakai)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<domain-backend>/api/oauth/google/callback   # tanpa ini bawaannya localhost
# Kunci enkripsi token Gmail. Bila kosong dipakai SESSION_ENCRYPTION_KEY. NILAINYA HARUS SAMA dengan yang
# dipakai worker, karena worker mendekripsi token itu.
# OAUTH_TOKEN_ENCRYPTION_KEY=

# Model AI dan cadangan (opsional)
# OPENROUTER_MODEL=
# GROQ_API_KEY=

# Pengumuman status lamaran lewat Telegram (opsional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Notifikasi multi-channel per pengguna (bawaan mati; aktifkan hanya setelah migrasi notifikasi dijalankan)
# NOTIFICATIONS_ENABLED=false
# NOTIFY_OTP_PEPPER=your-random-32-char-otp-pepper
# KAPSO_API_KEY=
# KAPSO_PHONE_NUMBER_ID=
# KAPSO_WEBHOOK_SECRET=
# KAPSO_TEMPLATE_NAME=
# KAPSO_TEMPLATE_LANG=id
# KAPSO_OTP_TEMPLATE_NAME=
# KAPSO_OTP_TEMPLATE_LANG=id
# KAPSO_OTP_TEMPLATE_INCLUDE_BUTTON=true
# KAPSO_SANDBOX_MODE=false
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=
